{
  "name": "@recommendai/sdk",
  "version": "1.0.0",
  "description": "Official TypeScript/JavaScript SDK for RecSys.AI",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "simulate": "ts-node examples/simulation.ts"
  },
  "keywords": [
    "recommendations",
    "machine-learning",
    "api-client",
    "sdk",
    "typescript"
  ],
  "author": "RecSys.AI Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/recsys-ai/recommendai-sdks.git",
    "directory": "typescript"
  },
  "dependencies": {
    "axios": "^1.8.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    }
  }
}
