{
  "name": "recsys-ai/recommendai",
  "description": "Official PHP SDK for the RecSys.AI personalised-recommendation platform",
  "type": "library",
  "license": "MIT",
  "version": "1.0.0",
  "require": {
    "php": ">=8.1",
    "guzzlehttp/guzzle": "^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "RecommendAI\\": "src/"
    },
    "classmap": ["src/"]
  },
  "autoload-dev": {
    "psr-4": {
      "RecommendAI\\Tests\\": "tests/"
    }
  },
  "authors": [
    { "name": "RecSys.AI", "homepage": "https://recsys-ai.com" }
  ],
  "minimum-stability": "stable"
}
